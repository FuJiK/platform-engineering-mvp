{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/data.json {:mvn/version "2.5.2"}}
 :aliases
 {:generate {:main-opts ["-m" "platform-mvp.compiler"]}
  :mcp      {:main-opts ["-m" "platform-mvp.mcp"]}
  :test     {:extra-paths ["test"]
             :main-opts ["-m" "platform-mvp.test-runner"]}}}
